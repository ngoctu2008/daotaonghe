+      // --- ADMIN LOGIC ---
+      function loadAccounts() {
+        let tbody = document.querySelector('#accountsTable tbody');
+        tbody.innerHTML = '<tr><td colspan="4" class="text-center">Đang tải...</td></tr>';
+        google.script.run.withSuccessHandler(accounts => {
+          tbody.innerHTML = '';
+          accounts.forEach(a => {
+            let tr = document.createElement('tr');
+            let actions = `<button class="btn btn-sm btn-outline-primary py-0" onclick="editAccount('${encodeURIComponent(JSON.stringify(a))}')"><i class="bi bi-pencil"></i></button>
+                           <button class="btn btn-sm btn-outline-danger py-0" onclick="deleteAccount(${a.rowIndex})"><i class="bi bi-trash"></i></button>`;
+            tr.innerHTML = `<td>${escapeHtml(a.username)}</td><td>${escapeHtml(a.role)}</td><td>${escapeHtml(a.name)}</td><td>${actions}</td>`;
+            tbody.appendChild(tr);
+          });
+        }).getAccounts(currentUser);
+      }
+
+      function openAccountForm() {
+        document.getElementById('accountFormArea').classList.remove('hidden');
+        document.getElementById('accountFormTitle').innerText = "Thêm Tài khoản";
+        document.getElementById('aRowIndex').value = "";
+        document.getElementById('a_user').value = ""; document.getElementById('a_pass').value = "";
+        document.getElementById('a_role').value = "GiaoVien"; document.getElementById('a_name').value = "";
+        document.getElementById('a_msg').innerText = "";
+      }
+
+      function editAccount(safeObj) {
+        let a = JSON.parse(decodeURIComponent(safeObj));
+        document.getElementById('accountFormArea').classList.remove('hidden');
+        document.getElementById('accountFormTitle').innerText = "Sửa Tài khoản";
+        document.getElementById('aRowIndex').value = a.rowIndex;
+        document.getElementById('a_user').value = a.username; document.getElementById('a_pass').value = a.password;
+        document.getElementById('a_role').value = a.role; document.getElementById('a_name').value = a.name;
+      }
+
+      function closeAccountForm() { document.getElementById('accountFormArea').classList.add('hidden'); }
+
+      function saveAccount() {
+        let rowIndex = document.getElementById('aRowIndex').value;
+        let data = { username: document.getElementById('a_user').value, password: document.getElementById('a_pass').value, role: document.getElementById('a_role').value, name: document.getElementById('a_name').value };
+        if(!data.username || !data.password) return alert("Vui lòng nhập tên đăng nhập và mật khẩu");
+        let msg = document.getElementById('a_msg'); msg.innerText = "Đang lưu...";
+        if (rowIndex) google.script.run.withSuccessHandler(res => { loadAccounts(); closeAccountForm(); }).updateAccount(rowIndex, data, currentUser);
+        else google.script.run.withSuccessHandler(res => { loadAccounts(); closeAccountForm(); }).addAccount(data, currentUser);
+      }
+
+      function deleteAccount(rowIndex) {
+        if(!confirm("Bạn chắc chắn muốn xóa tài khoản này?")) return;
+        google.script.run.withSuccessHandler(res => { alert(res.message); loadAccounts(); }).deleteAccount(rowIndex, currentUser);
+      }
+
+      function loadConfig() {
+        google.script.run.withSuccessHandler(config => {
+          document.getElementById('cfg_donxinhoc').value = config.donXinHoc || "";
+          document.getElementById('cfg_danhsachlop').value = config.danhSachLop || "";
+          document.getElementById('cfg_export').value = config.exportFolder || "";
+        }).getConfig(currentUser);
+      }
+
+      function saveConfigData() {
+        let data = {
+          donXinHoc: document.getElementById('cfg_donxinhoc').value.trim(),
+          danhSachLop: document.getElementById('cfg_danhsachlop').value.trim(),
+          exportFolder: document.getElementById('cfg_export').value.trim()
+        };
+        let alertBox = document.getElementById('cfgAlert'); alertBox.className = "alert alert-info py-2 small"; alertBox.innerText = "Đang lưu...";
+        google.script.run.withSuccessHandler(res => {
+          alertBox.className = res.success ? "alert alert-success py-2 small" : "alert alert-danger py-2 small";
+          alertBox.innerText = res.message;
+        }).saveConfig(data, currentUser);
+      }
     </script>
